# Copy to .env. Never use NEXT_PUBLIC_ for secrets.
ASA_DATABASE_URL=postgresql://asa:CHANGE_ME@127.0.0.1:5432/asa
# First provider adapter is OpenAI; other providers require their own adapter.
ASA_AI_PROVIDER=openai
ASA_AI_MODEL=
# JSON allowlist for direct AI blocks; ASA_AI_MODEL is also allowed.
ASA_AI_MODELS=[]
# USD per million tokens; keys are provider:model, e.g. openai:<model-id>.
# Configure verified rates before relying on cost estimates. See docs/ai-monitoring.md.
ASA_AI_PRICES={}
ASA_AI_API_KEY=
ASA_AI_TIMEOUT_SECONDS=60
# Enables paid automation API calls; leave false until provider/model/key are configured.
ASA_AUTOMATION_AI_ENABLED=false
# Rolling 24-hour call ceiling, including uncertain/failed external attempts.
ASA_AUTOMATION_DAILY_AI_CALLS=20
ASA_AUTOMATION_OUTPUT_TOKENS=2048
ASA_FFMPEG_PATH=ffmpeg
LANGSMITH_TRACING=false
# Local owner login (generate a random value of at least 32 characters).
ASA_OWNER_ACCESS_KEY=
ASA_WORKSPACE_ID=a5a00000-0000-4000-8000-000000000001
# Optional dedicated integration-test database; never point this at production.
ASA_TEST_DATABASE_URL=
ASA_ENVIRONMENT=production
ASA_DEV_LOGIN_ENABLED=false

# Web search (Brave API). Shared external-call quota with automation AI.
ASA_SEARCH_PROVIDER=brave
ASA_SEARCH_ENABLED=false
ASA_SEARCH_API_KEY=

# Claude models: JSON array of model IDs available to your Anthropic account.
ASA_ANTHROPIC_MODELS=[]
ASA_ANTHROPIC_API_KEY=

# Subsets of the provider model lists confirmed to support native web search.
ASA_OPENAI_WEB_SEARCH_MODELS=[]
ASA_ANTHROPIC_WEB_SEARCH_MODELS=[]
